#!/bin/bash
# omarchy-windows-vm hardcodes a bare `/sound` (FreeRDP's default audio
# buffering, which piles up seconds of latency over the loopback RDP link).
# Swap it for an explicit low-latency pulse target; everything else passes
# through untouched. Only reachable via omarchy-windows-vm-launch-fixed's PATH.

args=()
for a in "$@"; do
  if [[ $a == "/sound" ]]; then
    args+=("/sound:sys:pulse,latency:50")
  else
    args+=("$a")
  fi
done

shim_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PATH="${PATH//"$shim_dir":/}"
exec xfreerdp3 "${args[@]}"
