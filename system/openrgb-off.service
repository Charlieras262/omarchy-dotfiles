[Unit]
Description=Apagar RGB al apagar el equipo
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/bin/openrgb --mode static --color 000000
ExecStop=-/usr/bin/python3 -I @HOME@/.local/bin/aula-sync off
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
